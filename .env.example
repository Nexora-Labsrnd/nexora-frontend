# OPTIONAL — local development only.
# By default `npm run dev` proxies /api to http://127.0.0.1:8000 (vite.config.ts).
# Set this to a remote backend only if you want the local dev server to talk to it.
# Production ignores this value: vercel.json proxies /api/* to Render same-origin.
# VITE_API_URL=https://nexora-api-gu9p.onrender.com

# Where the Vite dev server forwards /api (server-side, not exposed to the browser).
# On Vercel, NEXORA_API_URL is also used by the SvelteKit /api fallback proxy;
# it defaults to https://nexora-api-gu9p.onrender.com when unset.
# NEXORA_API_URL=http://127.0.0.1:8000
